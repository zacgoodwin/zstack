#!/usr/bin/env bash
# One per-iteration drain tick for /z-loop (ticket #57, Leak 2): snapshot the
# board -> ingest it into the loop state -> ask the state machine for the next
# Action, printing ONLY that one-line Action JSON on stdout. Collapsing the old
# ~15-line snapshot+ingest+next block into this single wrapper stops the repeated
# bash command TEXT from re-entering the orchestrator's context on every one of a
# long drain's 100+ iterations.
#
# It shells only z-board and bun -- never the GitHub CLI directly. Bodies come
# from `z-board snapshot` (which fetches them through lib/board.ts, the sole
# sanctioned GitHub caller), so this wrapper stays free of any direct GitHub
# call and the caller gate in tests/board.test.ts keeps holding.
#
# It also runs the human-needed safety control (issue #63) every tick: writes
# the parked-tickets breakdown to $TMP/human-needed.json and, the moment it
# first crosses BoardConfig.humanNeededPercent, fires the one-time mid-run
# notification through lib/notify.ts -- same reasoning as above, a periodic
# per-tick check belongs in this wrapper, not a second bash block in
# z-loop/SKILL.md re-entering the orchestrator's context every iteration.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd -P)"
PACK="$(cd "$HERE/.." && pwd -P)"
# z-board resolution: an explicit $Z_BOARD wins (the loop preamble exports it,
# and the gate test injects a stub through it); otherwise prefer one on PATH,
# then the sibling in this bin dir. Never resolves to anything but a z-board.
Z_BOARD="${Z_BOARD:-$(command -v z-board 2>/dev/null || echo "$HERE/z-board")}"

SLUG=""; STATE=""; TMP=""; SESSION=""
while [ $# -gt 0 ]; do
  case "$1" in
    --slug) SLUG="$2"; shift 2 ;;
    --state) STATE="$2"; shift 2 ;;
    --tmp) TMP="$2"; shift 2 ;;
    --session) SESSION="$2"; shift 2 ;;
    *) echo "z-loop-tick: unknown argument '$1'" >&2; exit 1 ;;
  esac
done
# --session is REQUIRED, not optional (issue #198). An optional session that is
# simply absent would silently disable the liveness heartbeat and reintroduce
# the "a live loop reads stale" bug invisibly; failing here means it can only
# ever break loudly, on tick 1.
if [ -z "$SLUG" ] || [ -z "$STATE" ] || [ -z "$TMP" ] || [ -z "$SESSION" ]; then
  echo "usage: z-loop-tick --slug <slug> --state <state.json> --tmp <dir> --session <id>" >&2
  exit 1
fi

mkdir -p "$TMP"
# 0. Throttle (issue #58): sleep out the remainder of the project's
#    tickThrottleSeconds (config.json, default 0 = off) since the last tick,
#    then stamp this tick's start time. Proactive pacing that keeps
#    ProjectsV2 GraphQL spend under GitHub's 5k/hr budget, complementing the
#    reactive enforceQuota() backstop in lib/board.ts. No-op at the 0
#    default -- today's behavior unchanged.
bun "$PACK/lib/throttle.ts" wait --slug "$SLUG" >/dev/null
# 0b. Liveness heartbeat (issue #198): re-stamp loop.lock.beat so the loop lock
#     is judged by "last seen" rather than "started". Without it, any drain
#     outliving lockStalenessMinutes (60) reads STALE WHILE LIVE and the acquire
#     error tells the next operator to --reconcile over a running loop, which
#     prunes its worktrees and parks its tickets.
#     Placed BEFORE the snapshot deliberately: enforceQuota's sleep mode can park
#     a board call until the rate-limit window resets, so beat first, then do the
#     thing that might hang. Never aborts the tick (`|| true`) -- a locks-dir
#     hiccup must not wedge a drain -- and stderr is deliberately NOT discarded,
#     so a "foreign" beat (our lock was reconciled away) reaches the operator.
bun "$PACK/lib/locks.ts" beat --slug "$SLUG" --session "$SESSION" >/dev/null || true
# 1. Snapshot: all-status items + each ticket's body, one call, to files.
"$Z_BOARD" snapshot --slug "$SLUG" --out-items "$TMP/items.json" --out-bodies "$TMP/bodies.json" >/dev/null
# 1b. Live context reading (issue #131): how full the orchestrator's OWN
#     context window is right now, measured deterministically from its session
#     transcript. Fail-open by construction -- an unresolvable/unreadable
#     transcript prints 0, a transcript caught mid-write falls back to its last
#     complete reading (#157), and the `|| echo 0` backstops any hard error --
#     so a bad reading degrades to pre-#131 behavior (no gating) and NEVER
#     wedges the drain. Threaded into the ingest below as --context-tokens so the
#     context gate lives in the pure state machine, not this wrapper.
#     --project-dir is this wrapper's cwd = the orchestrator's cwd, whose mangled
#     form names the transcript dir.
#     stderr is NOT discarded (#157): command substitution captures stdout only,
#     so a diagnostic here reaches the operator's tick output without touching
#     $CTX -- and the two things worth seeing (context-budget reporting UNKNOWN,
#     i.e. that the 0 it printed is no measurement at all, on any of its unknown
#     paths; and the fail-loud usage-key drift assertion)
#     were the exact things a blanket 2>/dev/null hid while `|| echo 0` quietly
#     substituted a 0 that reads as "context is fine".
CTX=$(bun "$PACK/lib/context-budget.ts" current --project-dir "$PWD" || echo 0)
[ -z "$CTX" ] && CTX=0
# 1c. Targeted confirm pass (#138). The snapshot above is PAGINATED, so a ticket
#     missing from it proves nothing -- a short page and a real removal look
#     identical, and the ingest below simply carries every unobserved ticket
#     forward. That is always safe but not complete: a ticket genuinely removed
#     mid-run would keep its lane forever. So for exactly the tickets whose
#     absence matters (this state's lanes + its batch allow-list, computed by
#     `confirm-targets`, never guessed here), spend ONE single-ticket lookup
#     each. `z-board item` resolves the issue directly to its project item with
#     no pagination on the path, so its answer is positive either way: found ->
#     spliced back into the read, positively not on the project -> confirmed
#     gone, and only then does the ingest drop its lane. A lookup that FAILS
#     (transport, quota) emits nothing and that ticket just carries forward --
#     fail-open, the same safe direction as running no confirm pass at all.
#     The lookups file is always written (empty array when nothing was missed),
#     so the ingest command below has exactly one shape.
: > "$TMP/lookups.jsonl"
for MISSED in $(bun "$PACK/lib/loop.ts" confirm-targets "$STATE" "$TMP/items.json"); do
  "$Z_BOARD" item "$MISSED" --slug "$SLUG" >> "$TMP/lookups.jsonl" \
    || echo "z-loop-tick: single-ticket lookup for #$MISSED failed; carrying it forward unchanged" >&2
done
#     Fail-open on the slurp too: an unparseable line (a lookup killed mid-write)
#     degrades to "no confirmations this tick", never a dead drain under `set -e`.
jq -s '.' "$TMP/lookups.jsonl" > "$TMP/lookups.json" 2>/dev/null \
  || { echo "z-loop-tick: confirm-pass lookups were unreadable; carrying every missed ticket forward" >&2; echo "[]" > "$TMP/lookups.json"; }
# 2. Ingest: refresh ticket statuses; preserves lanes + lost-claim flags (no
#    config flags here -- Step 3's first ingest already set maxLanes/watchdog);
#    threads the fresh context reading (contextTokenLimit was captured at Step 3)
#    and the confirm pass's answers (#138). Its stdout is discarded, but its
#    stderr is NOT: the confirm notes ("read missed #N; ...") are the record of
#    what was actually proven about a missing ticket, and they belong in the
#    operator's tick output.
bun "$PACK/lib/loop.ts" ingest "$STATE" "$TMP/items.json" "$TMP/bodies.json" --lookups "$TMP/lookups.json" --context-tokens "$CTX" >/dev/null
# 2a. Watchdog heartbeat (issue #256): observe each live lane's stage-spawn
#     subtree and move its watchdog baseline forward to the newest transcript
#     append. Without this the baseline is only ever stamped by stage EVENTS
#     (claim / advance / respawn / outcome / an alive probe), so `watchdogExpired`
#     measures stage AGE and fires on a healthy stage -- a QA agent spends 2-4
#     minutes on its mandatory suite alone. The transcript reads belong out here
#     for the same reason the board read does: lib/loop.ts's decision functions
#     stay pure and network/disk-free, and the reducer is handed a number.
#     Placed AFTER the ingest (which is what settles the lane list this walks) and
#     BEFORE `next` (which is what reads the baseline). Never aborts the tick
#     (`|| true`) and never discards stderr -- an unresolvable transcript dir means
#     the watchdog silently degrades to its pre-#256 stage-age behavior, which is
#     exactly what an operator debugging a healthy-but-skipped stage must see.
bun "$PACK/lib/loop.ts" heartbeat "$STATE" --slug "$SLUG" --project-dir "$PWD" >/dev/null || true
# 2b. Human-needed safety control (issue #63): recompute the parked-tickets
# breakdown every tick (read-only) and fire the ONE-TIME mid-run breakdown
# notification the instant it first crosses BoardConfig.humanNeededPercent.
# Lives here -- not lib/loop.ts (which stays pure/network-free) and not a
# second per-tick block back in z-loop/SKILL.md -- so the check rides the same
# single-call-per-iteration cadence #57 already collapsed the drain loop into.
# The fire-once flag is set ONLY after notify.ts reports "sent": an
# unconfigured project or a down webhook must never wedge the ack, so the real
# notification still fires once it can actually be delivered. Never aborts the
# tick (`|| true`): a safety-control hiccup must not block the drain.
bun "$PACK/lib/loop.ts" human-needed "$STATE" > "$TMP/human-needed.json"
if [ "$(jq -r .tripped "$TMP/human-needed.json")" = "true" ] && [ "$(jq -r .alreadyNotified "$TMP/human-needed.json")" != "true" ]; then
  SENT=$(bun "$PACK/lib/notify.ts" send human-needed "$TMP/human-needed.json" --slug "$SLUG" 2>/dev/null) || SENT="error"
  [ "$SENT" = "sent" ] && bun "$PACK/lib/loop.ts" human-needed-ack "$STATE" >/dev/null || true
fi
# 3. Next: print exactly one Action JSON line -- the only thing the caller reads.
bun "$PACK/lib/loop.ts" next "$STATE"
