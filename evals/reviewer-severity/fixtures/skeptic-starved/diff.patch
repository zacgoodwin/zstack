+import { test, expect } from "bun:test";
+import { chunk } from "./chunk.ts";
+
+test("an exact multiple splits evenly", () => {
+  expect(chunk([1, 2, 3, 4], 2)).toEqual([[1, 2], [3, 4]]);
+});
+
+test("the final chunk is short, not padded", () => {
+  expect(chunk([1, 2, 3], 2)).toEqual([[1, 2], [3]]);
+});
+
+test("an empty list yields no chunks", () => {
+  expect(chunk([], 2)).toEqual([]);
+});
+
+test("a non-positive size throws RangeError", () => {
+  expect(() => chunk([1, 2], 0)).toThrow(RangeError);
+  expect(() => chunk([1, 2], -1)).toThrow(RangeError);
+});
+
+test("a fractional size throws RangeError", () => {
+  expect(() => chunk([1, 2], 1.5)).toThrow(RangeError);
+});
