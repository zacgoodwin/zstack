+// Fixed-window rate limiting. The timeline is tiled into windows of
+// `durationMs` starting at tick 0; window k is the HALF-OPEN interval
+// [k*durationMs, (k+1)*durationMs). The tick (k+1)*durationMs OPENS window
+// k+1: it is a member of the next window, never the one it ends.
+
+// The start tick of the window that `now` falls in.
+export function windowStartFor(now: number, durationMs: number): number {
+  if (durationMs <= 0) return now;
+  return Math.floor(now / durationMs) * durationMs;
+}
+
+// Membership test for the half-open window [start, start + durationMs): the
+// start tick is inside, the end tick belongs to the next window.
+export function withinWindow(now: number, start: number, durationMs: number): boolean {
+  if (durationMs <= 0) return false;
+  return now >= start && now < start + durationMs;
+}
+
+// Counts requests against the budget of the window each request's tick falls
+// in. Callers pass a monotonic clock: `now` never decreases across calls.
+export class FixedWindowLimiter {
+  private windowStart: number | undefined;
+  private count = 0;
+
+  constructor(private readonly limit: number, private readonly durationMs: number) {
+    if (!Number.isInteger(limit) || limit <= 0)
+      throw new RangeError(`limit must be a positive integer, got ${limit}`);
+    if (!Number.isInteger(durationMs) || durationMs <= 0)
+      throw new RangeError(`durationMs must be a positive integer, got ${durationMs}`);
+  }
+
+  // Admit the request at tick `now` when the window it falls in has budget left.
+  allow(now: number): boolean {
+    // Still inside the open window while `now` is at most a full duration past
+    // its open -- cheaper than recomputing windowStartFor on every request.
+    const inCurrentWindow = this.windowStart !== undefined && now - this.windowStart <= this.durationMs;
+    if (!inCurrentWindow) {
+      this.windowStart = windowStartFor(now, this.durationMs);
+      this.count = 0;
+    }
+    if (this.count >= this.limit) return false;
+    this.count += 1;
+    return true;
+  }
+}
