@@ -0,0 +1,65 @@
+import { test, expect } from "bun:test";
+import { FixedWindowLimiter, windowStartFor, withinWindow } from "./window.ts";
+
+// -- helpers: half-open membership (criterion 3) --
+test("the open tick is inside its window", () => {
+  expect(withinWindow(1000, 1000, 500)).toBe(true);
+});
+test("one ms before the next boundary is still this window", () => {
+  expect(withinWindow(1499, 1000, 500)).toBe(true);
+});
+test("the end tick belongs to the next window, never this one", () => {
+  expect(withinWindow(1500, 1000, 500)).toBe(false);
+});
+test("a tick before the window is outside", () => {
+  expect(withinWindow(999, 1000, 500)).toBe(false);
+});
+
+// -- helpers: window selection (criterion 3) --
+test("a mid-window tick maps to that window's start", () => {
+  expect(windowStartFor(1300, 500)).toBe(1000);
+});
+test("a boundary tick opens its own window", () => {
+  expect(windowStartFor(1500, 500)).toBe(1500);
+});
+test("every tick is a member of the window it selects", () => {
+  for (const now of [0, 1, 499, 500, 1300, 1500, 2999]) {
+    expect(withinWindow(now, windowStartFor(now, 500), 500)).toBe(true);
+  }
+});
+test("degenerate durations are guarded", () => {
+  expect(withinWindow(1000, 1000, 0)).toBe(false);
+  expect(windowStartFor(1000, 0)).toBe(1000);
+});
+
+// -- limiter: the window budget (criteria 1, 2) --
+test("admits up to the limit inside one window, then rejects", () => {
+  const l = new FixedWindowLimiter(2, 500);
+  expect(l.allow(1100)).toBe(true);
+  expect(l.allow(1200)).toBe(true);
+  expect(l.allow(1300)).toBe(false);
+});
+test("a fresh window restores the budget", () => {
+  const l = new FixedWindowLimiter(2, 500);
+  expect(l.allow(1100)).toBe(true);
+  expect(l.allow(1200)).toBe(true);
+  expect(l.allow(1600)).toBe(true);
+});
+test("a request landing on a window boundary is admitted", () => {
+  const l = new FixedWindowLimiter(2, 500);
+  expect(l.allow(1400)).toBe(true);
+  expect(l.allow(1500)).toBe(true);
+});
+test("a long idle gap rolls to the window the request falls in", () => {
+  const l = new FixedWindowLimiter(1, 500);
+  expect(l.allow(1000)).toBe(true);
+  expect(l.allow(5000)).toBe(true);
+});
+
+// -- limiter: constructor contract (criterion 4) --
+test("rejects a non-positive or non-integer limit or duration", () => {
+  expect(() => new FixedWindowLimiter(0, 500)).toThrow(RangeError);
+  expect(() => new FixedWindowLimiter(2, 0)).toThrow(RangeError);
+  expect(() => new FixedWindowLimiter(1.5, 500)).toThrow(RangeError);
+  expect(() => new FixedWindowLimiter(2, -500)).toThrow(RangeError);
+});
