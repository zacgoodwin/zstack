+++ b/src/limiter.test.ts
@@ -0,0 +1,163 @@
+import { test, expect } from "bun:test";
+import { KeyedRateLimiter } from "./limiter.ts";
+
+const opts = (over: Partial<{ limit: number; durationMs: number; idleTtlMs: number }> = {}) => ({
+  limit: 2,
+  durationMs: 500,
+  ...over,
+});
+
+// -- the window budget --
+test("admits up to the limit inside one window, then rejects", () => {
+  const l = new KeyedRateLimiter(opts());
+  expect(l.allow("a", 1100)).toBe(true);
+  expect(l.allow("a", 1200)).toBe(true);
+  expect(l.allow("a", 1300)).toBe(false);
+});
+test("a fresh window restores the budget", () => {
+  const l = new KeyedRateLimiter(opts());
+  expect(l.allow("a", 1100)).toBe(true);
+  expect(l.allow("a", 1200)).toBe(true);
+  expect(l.allow("a", 1600)).toBe(true);
+});
+test("a request landing on a window boundary is admitted", () => {
+  const l = new KeyedRateLimiter(opts());
+  expect(l.allow("a", 1400)).toBe(true);
+  expect(l.allow("a", 1500)).toBe(true);
+});
+test("an exhausted budget is restored exactly on the boundary tick", () => {
+  const l = new KeyedRateLimiter(opts({ limit: 1 }));
+  expect(l.allow("a", 1000)).toBe(true);
+  expect(l.allow("a", 1400)).toBe(false);
+  expect(l.allow("a", 1500)).toBe(true);
+});
+test("a long idle gap rolls to the window the request falls in", () => {
+  const l = new KeyedRateLimiter(opts({ limit: 1 }));
+  expect(l.allow("a", 1000)).toBe(true);
+  expect(l.allow("a", 5000)).toBe(true);
+});
+
+// -- per-key isolation --
+test("one key exhausting its budget does not affect another", () => {
+  const l = new KeyedRateLimiter(opts({ limit: 1 }));
+  expect(l.allow("a", 1000)).toBe(true);
+  expect(l.allow("a", 1100)).toBe(false);
+  expect(l.allow("b", 1100)).toBe(true);
+  expect(l.size).toBe(2);
+});
+
+// -- remaining --
+test("an unknown key has its full budget", () => {
+  expect(new KeyedRateLimiter(opts()).remaining("nobody", 1000)).toBe(2);
+});
+test("remaining counts down with each admitted request", () => {
+  const l = new KeyedRateLimiter(opts());
+  l.allow("a", 1000);
+  expect(l.remaining("a", 1100)).toBe(1);
+  l.allow("a", 1100);
+  expect(l.remaining("a", 1200)).toBe(0);
+});
+test("remaining reports a full budget once the window has passed", () => {
+  const l = new KeyedRateLimiter(opts({ limit: 1 }));
+  l.allow("a", 1000);
+  expect(l.remaining("a", 1200)).toBe(0);
+  expect(l.remaining("a", 1600)).toBe(1);
+});
+
+// -- retryAfterMs --
+test("a key with budget waits for nothing", () => {
+  const l = new KeyedRateLimiter(opts());
+  l.allow("a", 1000);
+  expect(l.retryAfterMs("a", 1100)).toBe(0);
+});
+test("an exhausted key waits until its window closes", () => {
+  const l = new KeyedRateLimiter(opts({ limit: 1 }));
+  l.allow("a", 1000);
+  expect(l.retryAfterMs("a", 1100)).toBe(400);
+  expect(l.retryAfterMs("a", 1499)).toBe(1);
+});
+test("an unknown key waits for nothing", () => {
+  expect(new KeyedRateLimiter(opts()).retryAfterMs("nobody", 1000)).toBe(0);
+});
+test("once the window has passed there is nothing left to wait for", () => {
+  const l = new KeyedRateLimiter(opts({ limit: 1 }));
+  l.allow("a", 1000);
+  expect(l.retryAfterMs("a", 1600)).toBe(0);
+});
+
+// -- peek --
+test("peek reports an unknown key as admissible", () => {
+  expect(new KeyedRateLimiter(opts()).peek("nobody", 1000)).toBe(true);
+});
+test("peek does not charge the budget it reports on", () => {
+  const l = new KeyedRateLimiter(opts());
+  l.allow("a", 1000);
+  expect(l.peek("a", 1100)).toBe(true);
+  expect(l.peek("a", 1100)).toBe(true);
+  expect(l.remaining("a", 1100)).toBe(1);
+});
+test("peek reports an exhausted key as inadmissible", () => {
+  const l = new KeyedRateLimiter(opts({ limit: 1 }));
+  l.allow("a", 1000);
+  expect(l.peek("a", 1200)).toBe(false);
+});
+test("peek still reports the closed budget on the window's last tick", () => {
+  const l = new KeyedRateLimiter(opts({ limit: 1 }));
+  l.allow("a", 1000);
+  expect(l.peek("a", 1499)).toBe(false);
+});
+test("peek and remaining agree on the budget a boundary tick opens", () => {
+  const l = new KeyedRateLimiter(opts());
+  l.allow("a", 1000);
+  expect(l.peek("a", 1500)).toBe(true);
+  expect(l.remaining("a", 1500)).toBe(2);
+});
+test("peek sees a fresh budget once the window has rolled past", () => {
+  const l = new KeyedRateLimiter(opts({ limit: 1 }));
+  l.allow("a", 1000);
+  expect(l.peek("a", 1501)).toBe(true);
+  expect(l.peek("a", 2000)).toBe(true);
+});
+
+// -- reset --
+test("reset restores a key's budget immediately", () => {
+  const l = new KeyedRateLimiter(opts({ limit: 1 }));
+  l.allow("a", 1000);
+  expect(l.allow("a", 1100)).toBe(false);
+  l.reset("a");
+  expect(l.allow("a", 1100)).toBe(true);
+});
+test("resetAll drops every bucket", () => {
+  const l = new KeyedRateLimiter(opts({ limit: 1 }));
+  l.allow("a", 1000);
+  l.allow("b", 1000);
+  l.resetAll();
+  expect(l.size).toBe(0);
+});
+
+// -- sweep --
+test("sweep reclaims a key idle for the full ttl and reports the count", () => {
+  const l = new KeyedRateLimiter(opts({ idleTtlMs: 1000 }));
+  l.allow("a", 1000);
+  expect(l.sweep(1500)).toBe(0);
+  expect(l.size).toBe(1);
+  expect(l.sweep(2000)).toBe(1);
+  expect(l.size).toBe(0);
+});
+test("a rejected request still keeps its key alive", () => {
+  const l = new KeyedRateLimiter(opts({ limit: 1, idleTtlMs: 1000 }));
+  expect(l.allow("a", 1000)).toBe(true);
+  expect(l.allow("a", 1200)).toBe(false);
+  expect(l.sweep(2100)).toBe(0);
+});
+
+// -- constructor contract --
+test("rejects a non-positive or non-integer limit or duration", () => {
+  expect(() => new KeyedRateLimiter(opts({ limit: 0 }))).toThrow(RangeError);
+  expect(() => new KeyedRateLimiter(opts({ limit: 1.5 }))).toThrow(RangeError);
+  expect(() => new KeyedRateLimiter(opts({ durationMs: 0 }))).toThrow(RangeError);
+  expect(() => new KeyedRateLimiter(opts({ durationMs: -500 }))).toThrow(RangeError);
+});
+test("rejects an idle ttl shorter than one window", () => {
+  expect(() => new KeyedRateLimiter(opts({ idleTtlMs: 499 }))).toThrow(RangeError);
+});
diff --git a/src/limiter.ts b/src/limiter.ts
new file mode 100644
index 0000000..bfa56e3
--- /dev/null
+++ b/src/limiter.ts
@@ -0,0 +1,164 @@
+import { msUntilWindowEnd, windowStartFor, withinWindow } from "./window.ts";
+
+// Per-key fixed-window rate limiting.
+//
+// Each key gets its own budget of `limit` requests per `durationMs` window,
+// judged against the window the request's tick falls in (see window.ts for the
+// half-open tiling rule). Callers pass a monotonic clock: `now` never
+// decreases across calls, so a bucket's window can only ever move forward.
+//
+// Buckets are kept in a Map and reclaimed by `sweep()`, so a process that sees
+// many short-lived keys does not grow without bound.
+
+export interface RateLimiterOptions {
+  /** Requests admitted per key per window. */
+  limit: number;
+  /** Window length in integer milliseconds. */
+  durationMs: number;
+  /**
+   * How long a key may go untouched before `sweep()` may reclaim it. Defaults
+   * to ten windows. Never shorter than one window: reclaiming a key whose
+   * window is still open would hand it a fresh budget early.
+   */
+  idleTtlMs?: number;
+}
+
+interface Bucket {
+  /** Start tick of the window this bucket's `count` belongs to. */
+  windowStart: number;
+  /** Requests admitted so far inside `windowStart`'s window. */
+  count: number;
+  /** Tick of the most recent call that touched this bucket. */
+  lastSeen: number;
+}
+
+function assertPositiveInt(name: string, value: number): void {
+  if (!Number.isInteger(value) || value <= 0) {
+    throw new RangeError(`${name} must be a positive integer, got ${value}`);
+  }
+}
+
+export class KeyedRateLimiter {
+  private readonly limit: number;
+  private readonly durationMs: number;
+  private readonly idleTtlMs: number;
+  private readonly buckets = new Map<string, Bucket>();
+
+  constructor(options: RateLimiterOptions) {
+    assertPositiveInt("limit", options.limit);
+    assertPositiveInt("durationMs", options.durationMs);
+    const idleTtlMs = options.idleTtlMs ?? options.durationMs * 10;
+    assertPositiveInt("idleTtlMs", idleTtlMs);
+    if (idleTtlMs < options.durationMs) {
+      throw new RangeError(
+        `idleTtlMs (${idleTtlMs}) must be at least durationMs (${options.durationMs})`
+      );
+    }
+    this.limit = options.limit;
+    this.durationMs = options.durationMs;
+    this.idleTtlMs = idleTtlMs;
+  }
+
+  /** Number of keys currently holding a bucket. */
+  get size(): number {
+    return this.buckets.size;
+  }
+
+  /**
+   * Admit the request from `key` at tick `now` when the window that tick falls
+   * in still has budget, and charge it. Rejected requests still refresh
+   * `lastSeen`, so a key hammering a closed budget is not reclaimed mid-window.
+   */
+  allow(key: string, now: number): boolean {
+    const bucket = this.live(key, now);
+    bucket.lastSeen = now;
+    if (bucket.count >= this.limit) return false;
+    bucket.count += 1;
+    return true;
+  }
+
+  /**
+   * Whether a request from `key` would be admitted at tick `now`, without
+   * charging it.
+   */
+  peek(key: string, now: number): boolean {
+    const bucket = this.buckets.get(key);
+    if (bucket === undefined) return true;
+    // Read-only, so this cannot go through `live()` -- that rolls the bucket
+    // onto a new window and resets its count, which would make a peek mutate
+    // the state it is only supposed to report on. The bucket's window is still
+    // the live one while `now` has not run past a full duration from its open.
+    const sameWindow = now - bucket.windowStart <= this.durationMs;
+    if (!sameWindow) return true;
+    return bucket.count < this.limit;
+  }
+
+  /** Budget left for `key` in the window `now` falls in. */
+  remaining(key: string, now: number): number {
+    const bucket = this.buckets.get(key);
+    if (bucket === undefined) return this.limit;
+    if (!withinWindow(now, bucket.windowStart, this.durationMs)) return this.limit;
+    return Math.max(0, this.limit - bucket.count);
+  }
+
+  /**
+   * Milliseconds the caller should wait before retrying, or 0 when `key` has
+   * budget right now. Suitable for a `Retry-After` header.
+   */
+  retryAfterMs(key: string, now: number): number {
+    const bucket = this.buckets.get(key);
+    if (bucket === undefined) return 0;
+    if (bucket.count < this.limit) return 0;
+    return msUntilWindowEnd(now, bucket.windowStart, this.durationMs);
+  }
+
+  /** Drop `key`'s bucket, restoring its full budget immediately. */
+  reset(key: string): void {
+    this.buckets.delete(key);
+  }
+
+  /** Drop every bucket. */
+  resetAll(): void {
+    this.buckets.clear();
+  }
+
+  /**
+   * Reclaim buckets untouched for at least `idleTtlMs`, returning how many were
+   * dropped. Because `idleTtlMs` is never shorter than one window, a reclaimed
+   * bucket's window has always already closed, so this can never hand a key a
+   * fresh budget ahead of schedule.
+   */
+  sweep(now: number): number {
+    let removed = 0;
+    for (const [key, bucket] of this.buckets) {
+      if (now - bucket.lastSeen >= this.idleTtlMs) {
+        this.buckets.delete(key);
+        removed += 1;
+      }
+    }
+    return removed;
+  }
+
+  /**
+   * `key`'s bucket, rolled onto the window `now` falls in and created if
+   * absent. Mutating by design: callers that must not change state read
+   * `this.buckets` directly.
+   */
+  private live(key: string, now: number): Bucket {
+    const existing = this.buckets.get(key);
+    if (existing === undefined) {
+      const fresh: Bucket = {
+        windowStart: windowStartFor(now, this.durationMs),
+        count: 0,
+        lastSeen: now,
+      };
+      this.buckets.set(key, fresh);
+      return fresh;
+    }
+    if (!withinWindow(now, existing.windowStart, this.durationMs)) {
+      existing.windowStart = windowStartFor(now, this.durationMs);
+      existing.count = 0;
+    }
+    return existing;
+  }
+}
diff --git a/src/window.test.ts b/src/window.test.ts
