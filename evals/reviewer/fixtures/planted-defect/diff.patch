+++ b/src/window.ts
@@ -0,0 +1,33 @@
+// Fixed-window tiling of the timeline.
+//
+// The timeline is cut into windows of `durationMs` starting at tick 0. Window
+// k is the HALF-OPEN interval [k*durationMs, (k+1)*durationMs): the tick that
+// OPENS a window belongs to it, and the tick exactly `durationMs` later opens
+// the NEXT window, never the one it ends.
+//
+// That rule is the whole point of the module. Treat a window as closed at both
+// ends and one of two things happens: a burst straddling a boundary is counted
+// twice and slips the limit, or a request landing exactly on the tick is
+// rejected even though a fresh window just opened for it.
+
+/** The start tick of the window `now` falls in. */
+export function windowStartFor(now: number, durationMs: number): number {
+  if (durationMs <= 0) return now;
+  return Math.floor(now / durationMs) * durationMs;
+}
+
+/** Whether `now` is a member of the half-open window `[start, start + durationMs)`. */
+export function withinWindow(now: number, start: number, durationMs: number): boolean {
+  if (durationMs <= 0) return false;
+  return now >= start && now < start + durationMs;
+}
+
+/**
+ * Milliseconds from `now` until the window opened at `start` closes -- i.e.
+ * until the next window opens and budget is restored. Zero when `now` is not
+ * inside that window, since there is nothing to wait for.
+ */
+export function msUntilWindowEnd(now: number, start: number, durationMs: number): number {
+  if (!withinWindow(now, start, durationMs)) return 0;
+  return start + durationMs - now;
+}
