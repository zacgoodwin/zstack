index 0000000..09bf60b
--- /dev/null
+++ b/src/middleware.ts
@@ -0,0 +1,98 @@
+import type { KeyedRateLimiter } from "./limiter.ts";
+
+// HTTP edge for the keyed rate limiter.
+//
+// One middleware sits in front of the handler chain: it derives the client key
+// from a request header, asks the limiter whether this request fits the key's
+// budget, and either calls `next()` or answers 429 with a `Retry-After` telling
+// the client when its budget returns.
+//
+// The limiter itself is transport-agnostic (see limiter.ts); everything that
+// knows about requests, responses and status codes lives here.
+
+/** The slice of a Node-style request this middleware reads. */
+export interface RequestLike {
+  headers: Record<string, string | undefined>;
+}
+
+/** The slice of a Node-style response this middleware writes. */
+export interface ResponseLike {
+  statusCode: number;
+  setHeader(name: string, value: string): void;
+  end(body?: string): void;
+}
+
+/** Counts for the process's own dashboards. */
+export interface RateLimitMetrics {
+  /** Requests the middleware let through to the handler chain. */
+  admitted: number;
+  /** Requests the middleware answered with 429. */
+  rejected: number;
+}
+
+export interface RateLimitMiddlewareOptions {
+  limiter: KeyedRateLimiter;
+  /** Monotonic clock in milliseconds; injected so tests can drive time. */
+  now: () => number;
+  /** Header carrying the client id. Defaults to `x-client-id`. */
+  header?: string;
+  /** Key used for requests that arrive without the header. */
+  anonymousKey?: string;
+}
+
+export interface RateLimitMiddleware {
+  handle(req: RequestLike, res: ResponseLike, next: () => void): void;
+  readonly metrics: RateLimitMetrics;
+}
+
+/** How many requests pass between housekeeping sweeps of idle buckets. */
+const SWEEP_EVERY = 512;
+
+/** `Retry-After` is seconds on the wire (RFC 9110); the limiter speaks ms. */
+function retryAfterSeconds(ms: number): string {
+  return String(Math.round(ms / 1000));
+}
+
+export function rateLimitMiddleware(options: RateLimitMiddlewareOptions): RateLimitMiddleware {
+  const header = options.header ?? "x-client-id";
+  const anonymousKey = options.anonymousKey ?? "anonymous";
+  const metrics: RateLimitMetrics = { admitted: 0, rejected: 0 };
+  let seen = 0;
+
+  const handle = (req: RequestLike, res: ResponseLike, next: () => void): void => {
+    const now = options.now();
+    const key = req.headers[header] ?? anonymousKey;
+
+    // Reclamation runs in the shipped path, not merely on demand: a process
+    // fronting many short-lived client ids must keep its key table bounded.
+    seen += 1;
+    if (seen % SWEEP_EVERY === 0) options.limiter.sweep(now);
+
+    let allowed: boolean;
+    try {
+      allowed = options.limiter.allow(key, now);
+    } catch {
+      // The limiter is unavailable. Refuse rather than admit -- a broken
+      // limiter must never become an open door -- and still tell the client
+      // when it is worth coming back.
+      metrics.rejected += 1;
+      res.statusCode = 429;
+      res.setHeader("Retry-After", retryAfterSeconds(options.limiter.retryAfterMs(key, now)));
+      res.end("rate limited");
+      return;
+    }
+
+    if (allowed) {
+      metrics.admitted += 1;
+      next();
+      return;
+    }
+
+    metrics.rejected += 1;
+    res.statusCode = 429;
+    res.setHeader("Retry-After", retryAfterSeconds(options.limiter.retryAfterMs(key, now)));
+    res.end("rate limited");
+  };
+
+  return { handle, metrics };
+}
